CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash, one large app partition. PSRAM stays off so one image runs on V1 (quad PSRAM)
# and V2 (octal PSRAM) boards; the firmware does not need it.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 1 ms ticks: telemetry batching works in milliseconds
CONFIG_FREERTOS_HZ=1000

# PPP over the modem UART; LCP echo notices a hung modem within about 10 s.
# IPv4 only: some modems stall on IPV6CP.
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV6=n
CONFIG_LWIP_ENABLE_LCP_ECHO=y
CONFIG_LWIP_LCP_ECHOINTERVAL=3
CONFIG_LWIP_LCP_MAXECHOFAILS=3

# esp_modem reports internal errors as exceptions; without them it aborts
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Recover from any hang by rebooting
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# Camera (esp32-camera): its DMA buffer lives in internal RAM, as do the photos (PSRAM stays off)
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=16384

# esp_modem's multiplexer (CMUX) with the A7670E, which sends frames of up to 1500 bytes (2-byte
# lengths): no defragmenting into the DTE buffer, which then overflows; a buffer that grows for
# the odd long answer instead; a pause between opening channels; room for whole AT answers.
CONFIG_ESP_MODEM_CMUX_DEFRAGMENT_PAYLOAD=n
CONFIG_ESP_MODEM_USE_INFLATABLE_BUFFER_IF_NEEDED=y
CONFIG_ESP_MODEM_CMUX_DELAY_AFTER_DLCI_SETUP=100
CONFIG_ESP_MODEM_C_API_STR_MAX=256

# UART interrupts keep running while flash is written (the modem at 921600 baud has no flow control)
CONFIG_UART_ISR_IN_IRAM=y
